# ---------------------------------------------------------------------------
# Copy to .env for local development. In production these are the host's own
# environment variables — the env_file the container is started with on the
# VPS. See DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# A plain Postgres 16 connection string. Point this at a local Postgres for
# development, or the VPS's postgres container in production (see
# deploy/docker-compose.yml). Supabase's pooler string also works if you're
# still on that rollback path (see AUTH_PROVIDER below) — postgresql:// and
# postgres:// prefixes are normalised automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/speednum

# --- Authentication (self-hosted, default) ------------------------------------
# "local" (default) is this application's own Argon2id/Ed25519-JWT/rotating-
# refresh-token auth (services/local_auth.py) — nothing below this line is
# required for it to work. Leave AUTH_PROVIDER unset unless you're
# deliberately using the Supabase rollback path (SECURITY.md).
#AUTH_PROVIDER=local

# PEM-encoded Ed25519 private key that signs access tokens. Generate with:
#   openssl genpkey -algorithm ed25519
# Left unset, a fresh key is generated at boot and a warning is logged — every
# session is invalidated on the next restart, so set this for any real deploy.
JWT_PRIVATE_KEY=

# Where the frontend lives — used for links in outgoing email (sign-in,
# e-signature) and as the default Google OAuth redirect base. Leaving this at
# localhost in production sends dead links.
PUBLIC_APP_URL=http://localhost:3000

# --- Social login (optional) --------------------------------------------------
# "Continue with Google" only appears once both are set — GET /auth/oauth/providers
# reports which providers are actually live. Create a Google Cloud OAuth 2.0
# Client ID (Web application type); the authorized redirect URI must exactly
# match GOOGLE_REDIRECT_URI (or {PUBLIC_APP_URL}/oauth/callback/google if unset).
# Never put the secret in a NEXT_PUBLIC_* variable — this backend reads it, the
# browser never does.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Supabase (rollback path only — see SECURITY.md's "Authentication decision") --
# Only read when AUTH_PROVIDER=supabase or STORAGE_PROVIDER=supabase.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Comma-separated exact origins allowed to call this API from a browser.
# "*" is the default and is fine locally; in production it lets any website
# call the API with a user's token, and the app logs a warning at startup.
CORS_ORIGINS=http://localhost:3000

# Optional regex for origins that cannot be listed literally — in practice
# Vercel preview deployments, whose hostname carries a build hash. Leave blank
# unless you need it, and scope it to your own project:
#   CORS_ORIGIN_REGEX=https://speed-num[a-z0-9-]*\.vercel\.app
# A bare https://.*\.vercel\.app would admit anyone else's Vercel project too.
CORS_ORIGIN_REGEX=

# --- Email --------------------------------------------------------------------
# Pick ONE transport. With neither, messages are logged instead of sent: account
# creation still works and the UI shows the temporary password on screen, but no
# credential email, portal welcome or reminder digest is actually delivered.
#
# Check it after deploying:  GET  /api/v1/settings/email
# Send yourself a real test: POST /api/v1/settings/email/test
#
# "auto" (the default) uses Resend when its key is set, then SMTP when a host is
# set. Name one explicitly to stop a stray key silently changing the transport.
EMAIL_PROVIDER=auto

# Option A — SMTP, e.g. the mailbox on your own domain. On Hostinger that is
# smtp.hostinger.com:465 (implicit TLS); 587 (STARTTLS) also works. Port 25 is
# blocked on Hostinger VPS. Most providers require EMAIL_FROM to match the
# authenticated mailbox and refuse to relay anything else.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Leave unset — port 465 implies SSL and everything else uses STARTTLS. Set it
# only to override that.
#SMTP_SSL=

# Option B — Resend (https://resend.com). Verify your sending domain there first.
RESEND_API_KEY=

# The From address. The default below is Resend's shared sandbox domain, which
# only ever delivers to the Resend account owner's own address — real clients and
# staff would never receive their credentials. /settings/email warns about it.
EMAIL_FROM=SpidNums <onboarding@resend.dev>

# Where replies go when no specific person sent the message (the reminder
# digest, for instance). Optional.
EMAIL_REPLY_TO=

# --- Reminder scheduler -------------------------------------------------------
# The API sweeps every firm once a day, creating reminders for deadlines/tasks/letters
# that have crossed a lead time (30, 14, 10, 7, 3, 1, 0 days out, then daily once late)
# and emailing owners/admins a digest of anything new. Idempotent — a duplicate run
# creates nothing and emails no one.
#
# Safe to leave true with several uvicorn workers or replicas: each takes a Postgres
# advisory lock first and only one actually sweeps. Set false if you drive
# POST /admin/reminders/sweep from an external cron instead.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SWEEP_HOUR=6           # hour of day, UTC
REMINDER_SWEEP_ON_START=true    # also sweep shortly after boot

# --- Disaster-recovery backup snapshots ---------------------------------------
# Daily pg_dump + MinIO object archive to a dedicated `backups` bucket, synced
# and encrypted locally by the desktop app — see BACKUP_ARCHITECTURE.md.
BACKUP_SCHEDULER_ENABLED=true
BACKUP_SCHEDULER_HOUR=3                        # hour of day, UTC
BACKUP_INCREMENTAL_THRESHOLD_BYTES=524288000   # 500 MiB
BACKUP_SYNTHETIC_FULL_EVERY_N=30
BACKUP_DOWNLOAD_TTL_SECONDS=3600
BACKUP_S3_BUCKET=backups

ENVIRONMENT=development
LOG_LEVEL=INFO
