# ---------------------------------------------------------------------------
# Copy to .env for local development. On Hugging Face these are Space secrets:
#   Space -> Settings -> Variables and secrets
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler".
# Port 6543 is the pooler; it is IPv4-friendly, which the Space needs.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for projects still issuing legacy HS256 tokens
# (Project Settings -> API -> JWT Settings -> JWT Secret).
# Leave blank when the project uses asymmetric keys — JWKS is then used automatically.
SUPABASE_JWT_SECRET=

# Where the frontend lives — used for signing links and CORS.
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional transactional email (https://resend.com). Without it, emails are logged only.
RESEND_API_KEY=
EMAIL_FROM=SpeedNum <onboarding@resend.dev>

ENVIRONMENT=development
LOG_LEVEL=INFO
