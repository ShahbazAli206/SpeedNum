# ---------------------------------------------------------------------------
# Copy to .env for local development. In production these are the host's own
# environment variables — on Render that is Service -> Environment; on a VPS,
# the env_file the container is started with. See DEPLOYMENT.md.
#
# Hugging Face Spaces was the original target and is no longer supported: it
# now requires a paid plan and blocks outbound port 6543, which is exactly the
# port the Supabase pooler below listens on.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler".
# Port 6543 is the pooler and is IPv4-friendly; the direct db.<ref>.supabase.co
# host is IPv6-only and unreachable from most hosts. The backend detects :6543
# and disables prepared statements, which the pooler cannot support.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Required, and a real secret — it bypasses row-level security, so it must never
# reach the frontend. Without it, creating any login returns HTTP 424 (add
# accountant, add user, portal invite, bulk user import, resend credentials) and
# document upload/download URLs cannot be signed.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for projects still issuing legacy HS256 tokens
# (Project Settings -> API -> JWT Settings -> JWT Secret).
# Leave blank when the project uses asymmetric keys — JWKS is then used automatically.
SUPABASE_JWT_SECRET=

# Where the frontend lives — used for links in outgoing email (sign-in,
# e-signature). Leaving this at localhost in production sends dead links.
PUBLIC_APP_URL=http://localhost:3000

# Comma-separated exact origins allowed to call this API from a browser.
# "*" is the default and is fine locally; in production it lets any website
# call the API with a user's token, and the app logs a warning at startup.
CORS_ORIGINS=http://localhost:3000

# Optional regex for origins that cannot be listed literally — in practice
# Vercel preview deployments, whose hostname carries a build hash. Leave blank
# unless you need it, and scope it to your own project:
#   CORS_ORIGIN_REGEX=https://speed-num[a-z0-9-]*\.vercel\.app
# A bare https://.*\.vercel\.app would admit anyone else's Vercel project too.
CORS_ORIGIN_REGEX=

# --- Email --------------------------------------------------------------------
# Pick ONE transport. With neither, messages are logged instead of sent: account
# creation still works and the UI shows the temporary password on screen, but no
# credential email, portal welcome or reminder digest is actually delivered.
#
# Check it after deploying:  GET  /api/v1/settings/email
# Send yourself a real test: POST /api/v1/settings/email/test
#
# "auto" (the default) uses Resend when its key is set, then SMTP when a host is
# set. Name one explicitly to stop a stray key silently changing the transport.
EMAIL_PROVIDER=auto

# Option A — SMTP, e.g. the mailbox on your own domain. On Hostinger that is
# smtp.hostinger.com:465 (implicit TLS); 587 (STARTTLS) also works. Port 25 is
# blocked on Hostinger VPS. Most providers require EMAIL_FROM to match the
# authenticated mailbox and refuse to relay anything else.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Leave unset — port 465 implies SSL and everything else uses STARTTLS. Set it
# only to override that.
#SMTP_SSL=

# Option B — Resend (https://resend.com). Verify your sending domain there first.
RESEND_API_KEY=

# The From address. The default below is Resend's shared sandbox domain, which
# only ever delivers to the Resend account owner's own address — real clients and
# staff would never receive their credentials. /settings/email warns about it.
EMAIL_FROM=SpeedNum <onboarding@resend.dev>

# Where replies go when no specific person sent the message (the reminder
# digest, for instance). Optional.
EMAIL_REPLY_TO=

# --- Reminder scheduler -------------------------------------------------------
# The API sweeps every firm once a day, creating reminders for deadlines/tasks/letters
# that have crossed a lead time (30, 14, 10, 7, 3, 1, 0 days out, then daily once late)
# and emailing owners/admins a digest of anything new. Idempotent — a duplicate run
# creates nothing and emails no one.
#
# Safe to leave true with several uvicorn workers or replicas: each takes a Postgres
# advisory lock first and only one actually sweeps. Set false if you drive
# POST /admin/reminders/sweep from an external cron instead.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SWEEP_HOUR=6           # hour of day, UTC
REMINDER_SWEEP_ON_START=true    # also sweep shortly after boot

ENVIRONMENT=development
LOG_LEVEL=INFO
