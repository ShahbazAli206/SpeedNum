# ---------------------------------------------------------------------------
# STAGING top-level compose interpolation — copy to deploy/.env.staging on the
# VPS and fill in. Used by docker-compose.staging.yml for ${VAR} placeholders:
#
#   cp .env.staging.example .env.staging && chmod 600 .env.staging && nano .env.staging
#   docker compose -p speednum-staging --env-file .env.staging \
#     -f docker-compose.staging.yml --profile video up -d --build
#
# Same role and sensitivity as deploy/.env (see .env.example for the full
# rationale behind each value) — this is the STAGING copy, with its own
# credentials so nothing is shared with live. Gitignored; keep it mode 600.
# ---------------------------------------------------------------------------

# Staging Postgres. Its own password, distinct from live. `openssl rand -hex 24`.
POSTGRES_DB=speednum
POSTGRES_USER=speednum
POSTGRES_PASSWORD=

# Staging application DB role (see .env.example — least-privilege, not a
# superuser; the one-time role setup in DEPLOYMENT.md is run once against the
# staging Postgres data dir). Its own password, distinct from live.
POSTGRES_APP_USER=speednum_app
POSTGRES_APP_PASSWORD=

# Staging MinIO credentials. Distinct from live. `openssl rand -hex 24`.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

S3_BUCKET=documents

# Frontend build args — MUST be the staging hostnames, or the browser bundle
# would call the live API. Changing these needs `up -d --build frontend`.
NEXT_PUBLIC_API_URL=https://api.production.spidnums.com
NEXT_PUBLIC_SITE_URL=https://production.spidnums.com

# --- Video calling (LiveKit + coturn) -----------------------------------------
# Staging owns video while it is being fixed (live's video is off). Its own
# key/secret is cleanest; they only need to be internally consistent between the
# staging `api` and `livekit` services.
#   openssl rand -hex 16   # LIVEKIT_API_KEY
#   openssl rand -hex 32   # LIVEKIT_API_SECRET
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared between staging coturn and livekit (see .env.example). openssl rand -hex 32
TURN_SHARED_SECRET=
