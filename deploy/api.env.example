# ---------------------------------------------------------------------------
# Copy to deploy/api.env on the VPS and fill in. docker-compose.yml reads it as
# env_file. It holds live secrets, so it is gitignored — keep it 600 and owned
# by the deploy user:
#
#   cp api.env.example api.env && chmod 600 api.env && nano api.env
#
# Retrieval for every value below is documented in DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# --- Database (fatal if missing — the API raises at import time) -------------
# Supabase -> Settings -> Database -> Connection string -> "Transaction pooler".
# Port 6543, never the direct db.<ref>.supabase.co host (IPv6-only). Hostinger
# allows outbound 6543; only SMTP port 25 is blocked by default.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co

# Required. Without it, every account-creating route returns HTTP 424: add
# accountant, add user, portal invite, bulk import, resend credentials — and
# document uploads/downloads cannot be signed. It bypasses row-level security,
# so it must never be given to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Only for projects still issuing legacy HS256 tokens. Blank when the project
# uses asymmetric keys (this one does) — JWKS is then used automatically.
SUPABASE_JWT_SECRET=

# --- Web ---------------------------------------------------------------------
# The frontend's public URL. Every sign-in and e-signature link in an outgoing
# email is built from this; left at localhost, clients receive dead links.
PUBLIC_APP_URL=https://speed-num.vercel.app

# Exact origins allowed to call this API from a browser. Do not leave this "*"
# in production — it lets any website call the API with a signed-in user's token.
CORS_ORIGINS=https://speed-num.vercel.app

# Only if you need Vercel preview deployments, whose hostname carries a build
# hash. Scope it to your own project — a bare https://.*\.vercel\.app would
# admit every other Vercel project on the platform.
#CORS_ORIGIN_REGEX=https://speed-num[a-z0-9-]*\.vercel\.app

# --- Email -------------------------------------------------------------------
# Pick ONE transport. Without either, credential emails are logged instead of
# sent: accounts are still created and the temporary password is still shown on
# screen, but nobody receives their login.
#
# Verify after deploying with:  GET /api/v1/settings/email
# Send a real test with:        POST /api/v1/settings/email/test
#
# Option A — SMTP through the mailbox on your own domain (Hostinger hPanel ->
# Emails). No third-party account, and the From address is a domain your clients
# recognise. Port 465 is implicit TLS and is what Hostinger documents; 587
# (STARTTLS) also works. Port 25 is blocked on Hostinger VPS and will not work.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@yourdomain.com
SMTP_PASSWORD=
# The From address normally has to match the authenticated mailbox — most
# providers refuse to relay anything else.
EMAIL_FROM=SpeedNum <no-reply@yourdomain.com>

# Option B — Resend's HTTPS API (https://resend.com). Verify your sending domain
# in their dashboard first: the default onboarding@resend.dev only ever delivers
# to the Resend account owner's own address, so clients would never get theirs.
#EMAIL_PROVIDER=resend
#RESEND_API_KEY=
#EMAIL_FROM=SpeedNum <no-reply@yourdomain.com>

# Where replies go when no specific person sent the message (the reminder
# digest, for instance). Optional.
#EMAIL_REPLY_TO=support@yourdomain.com

# --- Reminder scheduler -------------------------------------------------------
# A daily in-process sweep that creates reminders for deadlines crossing a lead
# time and emails owners/admins a digest. A VPS container does not sleep, so
# this fires reliably here and no external cron is needed.
#
# Safe to leave true with WEB_CONCURRENCY > 1: workers take a Postgres advisory
# lock and only one sweeps. Set false only if you drive
# POST /api/v1/admin/reminders/sweep from an external cron instead.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SWEEP_HOUR=6
REMINDER_SWEEP_ON_START=true

# --- Runtime ------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
