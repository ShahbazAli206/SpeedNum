# ---------------------------------------------------------------------------
# Copy to deploy/api.env on the VPS and fill in. docker-compose.yml reads it as
# env_file. It holds live secrets, so it is gitignored — keep it 600 and owned
# by the deploy user:
#
#   cp api.env.example api.env && chmod 600 api.env && nano api.env
#
# Retrieval for every value below is documented in DEPLOYMENT.md.
#
# NOTE on DATABASE_URL / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: they are NOT
# set here. env_file entries are passed through literally — `${POSTGRES_PASSWORD}`
# written in this file would reach the container as that literal string, not
# the value — so those three are instead built in docker-compose.yml's own
# `environment:` block, which docker compose DOES interpolate from the
# project's top-level .env (see .env.example, a different file from this one).
# ---------------------------------------------------------------------------

# When running against Supabase Postgres instead of the VPS's own (see
# .env.example), unset this so 0002_rls.sql keeps providing its
# defence-in-depth RLS. When running against the VPS's own Postgres (no
# Supabase project colocated, so no `authenticated` role for those policies to
# apply to), set:
MIGRATIONS_SKIP=0002_rls

# --- Rollback: point at Supabase Postgres instead --------------------------
# Not used while docker-compose.yml's `environment:` block sets DATABASE_URL
# for you (the VPS-Postgres path). To roll back to Supabase Postgres instead:
# remove DATABASE_URL from the `api` and `migrate` services' `environment:`
# blocks in docker-compose.yml, uncomment the line below, fill it in, and also
# blank out MIGRATIONS_SKIP above. Port 6543, never the direct
# db.<ref>.supabase.co host (IPv6-only). Hostinger allows outbound 6543; only
# SMTP port 25 is blocked by default.
#DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# --- Authentication ------------------------------------------------------------
# "local" (default): this application's own auth — Argon2id passwords,
# Ed25519-signed (EdDSA) access tokens, rotating hashed refresh tokens. See
# SECURITY.md's "Authentication decision" for the reasoning, and
# ARCHITECTURE.md for the full flow.
AUTH_PROVIDER=local

# Required for AUTH_PROVIDER=local in any real deployment. Generate once:
#   openssl genpkey -algorithm ed25519 -out /tmp/jwt.pem && cat /tmp/jwt.pem && rm /tmp/jwt.pem
# Paste the whole PEM block as one value with literal \n between lines (env
# files don't support real newlines mid-value) — jwt_keys.py unescapes them.
# Left unset, a fresh key is generated at boot and a loud warning logged:
# every session is invalidated on the next restart, which is fine for a
# first boot with no users yet but not for a real deployment.
JWT_PRIVATE_KEY=

# Rotation without an outage: move a retired key's PUBLIC half here (still
# accepted for verifying not-yet-expired tokens) when JWT_PRIVATE_KEY
# changes to a new key. Leave blank normally. See services/jwt_keys.py.
JWT_PREVIOUS_PUBLIC_KEYS=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# The refresh-token cookie. SameSite=None (hardcoded in routers/auth.py,
# not configurable here) because the Vercel frontend and this API are
# different origins. Leave REFRESH_COOKIE_DOMAIN blank for a host-only
# cookie scoped to exactly this API's hostname.
REFRESH_COOKIE_NAME=sn_refresh
REFRESH_COOKIE_DOMAIN=

# --- Supabase Auth — ROLLBACK ONLY, inactive while AUTH_PROVIDER=local ------
# Identity was previously Supabase Auth regardless of which Postgres held the
# `public` schema; now fully replaced by the local system above. These are
# read only if AUTH_PROVIDER is switched back to "supabase" (see SECURITY.md).
SUPABASE_URL=https://<project-ref>.supabase.co

# Required only when AUTH_PROVIDER=supabase. Without it, every
# account-creating route returns HTTP 424: add accountant, add user, portal
# invite, bulk import, resend credentials. It bypasses row-level security,
# so it must never be given to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Only for projects still issuing legacy HS256 tokens. Blank when the project
# uses asymmetric keys (this one does) — JWKS is then used automatically.
SUPABASE_JWT_SECRET=

# --- Document storage ----------------------------------------------------------
# "s3" targets the VPS's own MinIO (see docker-compose.yml's `minio` service
# and .env.example for MINIO_ROOT_USER/PASSWORD). "supabase" keeps signing
# through Supabase Storage instead — set this to "supabase" to roll back
# without a code change (S3_* below are then simply unused).
STORAGE_PROVIDER=s3

# What the `api` container dials directly (internal Docker DNS — never
# publish a MinIO port on the host).
S3_ENDPOINT_URL=http://minio:9000
# What a presigned URL is signed for, since only the browser needs to reach
# it — Caddy proxies /documents/* (the bucket name, path-style) to MinIO
# (see ../Caddyfile.example). Bare host, NO path suffix: a SigV4 signature
# covers the exact request path, so anything Caddy rewrote before forwarding
# would no longer match what was signed and every presigned URL would fail
# with "Access Denied". Must match the hostname this API is actually reached
# at, and needs no trailing slash.
S3_PUBLIC_ENDPOINT_URL=https://test.spidnums.com
S3_BUCKET=documents
S3_REGION=us-east-1

# --- Web ---------------------------------------------------------------------
# The frontend's public URL. Every sign-in and e-signature link in an outgoing
# email is built from this; left at localhost, clients receive dead links.
PUBLIC_APP_URL=https://speed-num.vercel.app

# Exact origins allowed to call this API from a browser. Do not leave this "*"
# in production — it lets any website call the API with a signed-in user's token.
CORS_ORIGINS=https://speed-num.vercel.app

# Only if you need Vercel preview deployments, whose hostname carries a build
# hash. Scope it to your own project — a bare https://.*\.vercel\.app would
# admit every other Vercel project on the platform.
#CORS_ORIGIN_REGEX=https://speed-num[a-z0-9-]*\.vercel\.app

# --- Email -------------------------------------------------------------------
# Pick ONE transport. Without either, credential emails are logged instead of
# sent: accounts are still created and the temporary password is still shown on
# screen, but nobody receives their login.
#
# Verify after deploying with:  GET /api/v1/settings/email
# Send a real test with:        POST /api/v1/settings/email/test
#
# Option A — SMTP through the mailbox on your own domain (Hostinger hPanel ->
# Emails). No third-party account, and the From address is a domain your clients
# recognise. Port 465 is implicit TLS and is what Hostinger documents; 587
# (STARTTLS) also works. Port 25 is blocked on Hostinger VPS and will not work.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@yourdomain.com
SMTP_PASSWORD=
# The From address normally has to match the authenticated mailbox — most
# providers refuse to relay anything else.
EMAIL_FROM=SpeedNum <no-reply@yourdomain.com>

# Option B — Resend's HTTPS API (https://resend.com). Verify your sending domain
# in their dashboard first: the default onboarding@resend.dev only ever delivers
# to the Resend account owner's own address, so clients would never get theirs.
#EMAIL_PROVIDER=resend
#RESEND_API_KEY=
#EMAIL_FROM=SpeedNum <no-reply@yourdomain.com>

# Where replies go when no specific person sent the message (the reminder
# digest, for instance). Optional.
#EMAIL_REPLY_TO=support@yourdomain.com

# --- Reminder scheduler -------------------------------------------------------
# A daily in-process sweep that creates reminders for deadlines crossing a lead
# time and emails owners/admins a digest. A VPS container does not sleep, so
# this fires reliably here and no external cron is needed.
#
# Safe to leave true with WEB_CONCURRENCY > 1: workers take a Postgres advisory
# lock and only one sweeps. Set false only if you drive
# POST /api/v1/admin/reminders/sweep from an external cron instead.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SWEEP_HOUR=6
REMINDER_SWEEP_ON_START=true

# --- Runtime ------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
