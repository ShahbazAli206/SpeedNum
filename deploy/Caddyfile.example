# Lives on the VPS at /home/deploy/apps/caddy/Caddyfile — NOT part of this
# repo's own Docker Compose project. Caddy was set up once, independently,
# before this app existed (see DEPLOYMENT.md's VPS runbook), and is shared
# across whatever else eventually runs on this host. This file is checked in
# here only as the documented, reproducible source for what the VPS's copy
# should contain — copy it over, don't hand-edit the two out of sync.
#
# Apply:
#   scp deploy/Caddyfile.example deploy@2.25.108.16:/home/deploy/apps/caddy/Caddyfile
#   ssh deploy@2.25.108.16 'docker exec caddy caddy validate --config /etc/caddy/Caddyfile'
#   ssh deploy@2.25.108.16 'docker exec caddy caddy reload --config /etc/caddy/Caddyfile'
#
# Validate before reload, always — a bad config should never take the
# currently-working site down while Caddy tries to apply it.

{
	email sa38299793@gmail.com
}

# The frontend (see ../deploy/docker-compose.yml's `frontend` service) — self-hosted here
# instead of Vercel. Canonical origin; api.env's PUBLIC_APP_URL/CORS_ORIGINS must match it.
www.spidnums.com {
	handle {
		reverse_proxy speednum-frontend:3000
	}

	# Next.js content-hashes every filename under /_next/static/* (webpack build ID in the
	# path) — the file at a given URL never changes, so a year-long immutable cache is safe.
	# Everything else (pages, RSC payloads) is left at no special caching.
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"

	# zstd first (better ratio, less CPU than gzip), gzip as fallback for clients that don't
	# support it. next.config.ts turns off Next's own gzip so this is the only compression pass.
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/access-frontend.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# Apex and the old Vercel-era hostname both fold into the canonical www host above, so
# bookmarks and already-sent email links keep working. Caddy still issues each its own cert
# before redirecting — that's ACME/TLS working as intended, not a config mistake.
spidnums.com {
	redir https://www.spidnums.com{uri} permanent
}

syedi.spidnums.com {
	redir https://www.spidnums.com{uri} permanent
}

# Staging/validation hostname. Already resolves to this VPS (test A record
# predates this app) — used here to prove the whole stack end-to-end before
# any DNS is pointed at it for real. See DEPLOYMENT.md for the plan to move
# this to api.spidnums.com once a DNS record exists for it; nothing here
# needs to change to make that move, only the site address below.
test.spidnums.com {
	# MinIO's S3 API, presigned-URL traffic only. Matched on the bucket name
	# itself (path-style S3: /{bucket}/{key}), not a distinguishing prefix —
	# a SigV4 signature covers the exact request path, and any rewrite (a
	# prefix stripped by handle_path, for instance) changes the path MinIO
	# sees from the one that was actually signed, so every presigned URL
	# comes back "Access Denied". S3_PUBLIC_ENDPOINT_URL is the bare host
	# (https://test.spidnums.com — see deploy/api.env.example) with no path
	# suffix, so boto3 signs for exactly this path and nothing rewrites it
	# between the browser and MinIO. If S3_BUCKET is ever changed from
	# "documents", update this matcher to match.
	handle /documents/* {
		reverse_proxy speednum-minio:9000
	}

	# Same reasoning as /documents/* above, for the separate backups bucket
	# (config.py's BACKUP_S3_BUCKET) — disaster-recovery snapshot downloads,
	# also presigned-URL-only, also never rewritten. If BACKUP_S3_BUCKET is
	# ever changed from "backups", update this matcher too.
	handle /backups/* {
		reverse_proxy speednum-minio:9000
	}

	# Desktop app installer/update artifacts — see desktop/package.json's
	# `build.publish` (electron-updater's "generic" provider) and
	# DESKTOP.md's "Auto-update" section. Deliberately public-read
	# (`mc anonymous set download`), unlike /documents/* and /backups/*
	# above: this bucket holds only installer binaries and latest.yml, never
	# business data, and electron-updater's generic provider does a plain
	# unauthenticated GET — no presigned URL, no signature to preserve, so
	# no path-rewrite hazard either.
	handle /desktop-releases/* {
		reverse_proxy speednum-minio:9000
	}

	handle {
		# 12MB: the same limit the previously-written (never deployed)
		# nginx config carried — the API itself never receives a document
		# upload (those go browser-to-MinIO directly via a presigned URL,
		# see deploy/api.env.example's STORAGE_PROVIDER note), so the
		# largest body it legitimately accepts is a CSV/XLSX client/user
		# import (routers/imports.py). Caught by re-deriving this file from
		# scratch around Caddy instead of nginx — the limit has no other
		# enforcement point once nginx's client_max_body_size is gone.
		request_body {
			max_size 12MB
		}
		# Caddy already forwards X-Forwarded-Proto/Host/For by default —
		# app/main.py's uvicorn runs with --proxy-headers, so it reads them
		# without any extra header_up directives here.
		reverse_proxy speednum-api:8000
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# --- Video calling (LiveKit) — signaling/API only, NEVER media -------------
# LiveKit's WebSocket/HTTPS signaling port (7880) only. The actual WebRTC
# media (ICE/TCP on 7881, UDP on 50000-60000) must NEVER be routed through
# Caddy — Caddy speaks HTTP(S), not raw WebRTC, and the implementation spec
# is explicit that media must not go through it. Those ports are exposed
# directly by the `livekit` service's `network_mode: host` (see
# ../deploy/docker-compose.yml) and must be opened in the VPS firewall (UFW)
# separately — see DEPLOYMENT.md.
#
# `network_mode: host` also means the `livekit` container has no presence on
# the `web` bridge network this Caddy instance is on, so — unlike every
# block above — this can't `reverse_proxy` a container name. Two ways to
# reach it instead; NEITHER has been verified against the real VPS yet, do
# that before relying on this block:
#
#   (a) If Caddy's own container/compose config can be given
#       `extra_hosts: ["host.docker.internal:host-gateway"]` (Docker 20.10+,
#       Linux — very likely true on a modern Hostinger VPS, but this repo
#       doesn't own Caddy's own compose file to add it for you):
#       reverse_proxy host.docker.internal:7880
#   (b) Otherwise, the Docker bridge gateway address reaches the host's own
#       network stack from any bridge-networked container. Find it with, on
#       the VPS itself:
#         docker network inspect web --format '{{(index .IPAM.Config 0).Gateway}}'
#       and use that address in place of host.docker.internal below.
#
video.spidnums.com {
	handle {
		reverse_proxy host.docker.internal:7880
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/access-video.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# turn.spidnums.com is deliberately NOT a Caddy site block: coturn
# (network_mode: host, ../deploy/docker-compose.yml) owns its own TLS
# listener directly on 5349 with its own certificate (see
# ../deploy/turnserver.conf.example) — raw TURN-over-TLS is not HTTP(S), so
# Caddy has nothing to reverse-proxy here. Only the DNS record needs to
# exist; Caddy never touches this hostname's traffic.

# --- STAGING (production.spidnums.com) -------------------------------------
# The staging environment — a second, isolated stack on this same VPS (see
# ../deploy/docker-compose.staging.yml and STAGING.md). Reverse-proxies to the
# `speednum-staging-*` containers on the shared `web` network, exactly as the
# live blocks above reach `speednum-*`. Add these two blocks only after the DNS
# A records for production.spidnums.com and api.production.spidnums.com resolve
# to this VPS (Caddy will otherwise retry ACME against a non-resolving name).
# Always `caddy validate` before `caddy reload` — a bad edit here must never
# take the live www/test blocks above down.

# Staging FRONTEND. Gated with HTTP basic auth so the public (and search
# engines) cannot reach a site running on a full copy of real customer data.
# The gate is only on the frontend: the SPA's browser fetch and Next.js's
# server-side fetch to the API cannot carry basic-auth credentials, so gating
# api.production.spidnums.com the same way would break staging. That host is
# protected by the app's own JWT login instead (same as the live API).
production.spidnums.com {
	# Generate the hash on the VPS with:
	#   docker exec caddy caddy hash-password --plaintext 'your-staging-password'
	# and paste its output below. `basic_auth` is the current directive name;
	# on Caddy older than v2.8 use `basicauth` instead.
	basic_auth {
		staging REPLACE_WITH_caddy_hash-password_OUTPUT
	}

	handle {
		reverse_proxy speednum-staging-frontend:3000
	}

	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	encode zstd gzip

	header {
		# Keep a full copy of real data out of every search index.
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/access-staging-frontend.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# Staging API + object storage. Mirrors the test.spidnums.com block above but
# points at the staging containers. No basic_auth (see the frontend block's
# note) — the app's login gates the data. If you want to lock it to your own IP
# as well, add a matcher:  @office remote_ip 203.0.113.5  and `handle @office`.
api.production.spidnums.com {
	# Presigned-URL traffic, path-style S3 — matched on the bucket name and
	# never rewritten (a SigV4 signature covers the exact path). See the
	# test.spidnums.com block for the full reasoning.
	handle /documents/* {
		reverse_proxy speednum-staging-minio:9000
	}
	handle /backups/* {
		reverse_proxy speednum-staging-minio:9000
	}
	handle /desktop-releases/* {
		reverse_proxy speednum-staging-minio:9000
	}

	handle {
		request_body {
			max_size 12MB
		}
		reverse_proxy speednum-staging-api:8000
	}

	encode gzip

	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/access-staging-api.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

