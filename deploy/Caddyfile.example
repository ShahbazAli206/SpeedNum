# Lives on the VPS at /home/deploy/apps/caddy/Caddyfile — NOT part of this
# repo's own Docker Compose project. Caddy was set up once, independently,
# before this app existed (see DEPLOYMENT.md's VPS runbook), and is shared
# across whatever else eventually runs on this host. This file is checked in
# here only as the documented, reproducible source for what the VPS's copy
# should contain — copy it over, don't hand-edit the two out of sync.
#
# Apply:
#   scp deploy/Caddyfile.example deploy@2.25.108.16:/home/deploy/apps/caddy/Caddyfile
#   ssh deploy@2.25.108.16 'docker exec caddy caddy validate --config /etc/caddy/Caddyfile'
#   ssh deploy@2.25.108.16 'docker exec caddy caddy reload --config /etc/caddy/Caddyfile'
#
# Validate before reload, always — a bad config should never take the
# currently-working site down while Caddy tries to apply it.

{
	email sa38299793@gmail.com
}

# Staging/validation hostname. Already resolves to this VPS (test A record
# predates this app) — used here to prove the whole stack end-to-end before
# any DNS is pointed at it for real. See DEPLOYMENT.md for the plan to move
# this to api.spidnums.com once a DNS record exists for it; nothing here
# needs to change to make that move, only the site address below.
test.spidnums.com {
	# MinIO's S3 API, presigned-URL traffic only. Matched on the bucket name
	# itself (path-style S3: /{bucket}/{key}), not a distinguishing prefix —
	# a SigV4 signature covers the exact request path, and any rewrite (a
	# prefix stripped by handle_path, for instance) changes the path MinIO
	# sees from the one that was actually signed, so every presigned URL
	# comes back "Access Denied". S3_PUBLIC_ENDPOINT_URL is the bare host
	# (https://test.spidnums.com — see deploy/api.env.example) with no path
	# suffix, so boto3 signs for exactly this path and nothing rewrites it
	# between the browser and MinIO. If S3_BUCKET is ever changed from
	# "documents", update this matcher to match.
	handle /documents/* {
		reverse_proxy speednum-minio:9000
	}

	handle {
		# Caddy already forwards X-Forwarded-Proto/Host/For by default —
		# app/main.py's uvicorn runs with --proxy-headers, so it reads them
		# without any extra header_up directives here.
		reverse_proxy speednum-api:8000
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
