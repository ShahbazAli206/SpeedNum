# ---------------------------------------------------------------------------
# STAGING API env — copy to deploy/api.staging.env on the VPS and fill in.
# docker-compose.staging.yml reads it as the api/migrate env_file. Holds
# secrets; gitignored; keep it 600 and owned by the deploy user:
#
#   cp api.staging.env.example api.staging.env && chmod 600 api.staging.env && nano api.staging.env
#
# This mirrors deploy/api.env.example (read that for the rationale behind every
# key). Only the STAGING-SPECIFIC values are called out below; everything else
# should match live. DATABASE_URL / S3 creds / LIVEKIT_API_KEY|SECRET are NOT
# set here — they come from docker-compose.staging.yml's environment block,
# interpolated from deploy/.env.staging.
# ---------------------------------------------------------------------------

# VPS Postgres (not Supabase) — keep the RLS migration skipped as on live.
MIGRATIONS_SKIP=0002_rls

# --- Authentication -----------------------------------------------------------
AUTH_PROVIDER=local
# Generate a SEPARATE key for staging so staging tokens are never valid on live:
#   openssl genpkey -algorithm ed25519 | base64 -w0
JWT_PRIVATE_KEY=
JWT_PREVIOUS_PUBLIC_KEYS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=sn_refresh
REFRESH_COOKIE_DOMAIN=

# --- Social login (optional) --------------------------------------------------
# Leave blank on staging unless you register a staging OAuth redirect URI in
# Google Cloud Console. Password login works regardless (the DB is a copy of
# live, so all existing logins work).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Document storage ---------------------------------------------------------
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://minio:9000
# STAGING: presigned URLs are signed for the staging storage host. Bare host,
# no path suffix, no trailing slash (see api.env.example for why).
S3_PUBLIC_ENDPOINT_URL=https://api.production.spidnums.com
S3_BUCKET=documents
S3_REGION=us-east-1

# --- Web ----------------------------------------------------------------------
# STAGING: every email link and e-signature URL is built from this — must be
# the staging frontend, or test emails would link people into live.
PUBLIC_APP_URL=https://production.spidnums.com
CORS_ORIGINS=https://production.spidnums.com

# --- Email --------------------------------------------------------------------
# Staging sends for real (so deliverability is genuinely tested) but the
# redirect below guarantees no real customer is contacted. Same SMTP mailbox as
# live is fine.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@yourdomain.com
SMTP_PASSWORD=
EMAIL_FROM=SpidNums <no-reply@yourdomain.com>

# --- STAGING recipient redirect (customer-safety) -----------------------------
# The staging DB is a full copy of live, so every stored address is a real
# customer's. EMAIL_REDIRECT_TO rewrites the recipient of EVERY outgoing message
# to one address you control (the send is otherwise completely real). This also
# neutralises the reminder scheduler, which would otherwise auto-email real
# customers. MUST be set on staging; MUST be empty on live.
EMAIL_REDIRECT_TO=you@example.com
# Comma-separated addresses (a@b.com) or domains (@b.com / b.com) delivered
# unchanged, so your own test accounts still receive their mail for a genuine
# end-to-end check.
EMAIL_REDIRECT_ALLOWLIST=you@example.com

# --- Reminder scheduler -------------------------------------------------------
# Left on so the feature is exercised on staging; the redirect above keeps its
# digests off real customers. Set false if the daily digest to you is noise.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SWEEP_HOUR=6
REMINDER_SWEEP_ON_START=true

# --- Disaster-recovery backup snapshots ---------------------------------------
# Off on staging by default — no need to spend CPU/disk snapshotting a test env.
BACKUP_SCHEDULER_ENABLED=false
BACKUP_SCHEDULER_HOUR=3
BACKUP_INCREMENTAL_THRESHOLD_BYTES=524288000
BACKUP_SYNTHETIC_FULL_EVERY_N=30
BACKUP_DOWNLOAD_TTL_SECONDS=3600
BACKUP_S3_BUCKET=backups

# --- Video calling (LiveKit + coturn) -----------------------------------------
# Staging owns video for now, on the same public hostname (live's is off).
LIVEKIT_URL=wss://video.spidnums.com
CALL_RINGING_TIMEOUT_SECONDS=30
LIVEKIT_TOKEN_TTL_SECONDS=21600

# --- Runtime ------------------------------------------------------------------
# `staging`, not `production` — keeps settings.is_production False for this env.
ENVIRONMENT=staging
LOG_LEVEL=INFO
