# ---------------------------------------------------------------------------
# Copy to deploy/.env on the VPS (note: `.env`, not `api.env` — this is a
# different file). docker compose auto-loads a file with this exact name from
# the project directory to interpolate ${VAR} placeholders inside
# docker-compose.yml itself — a different mechanism from api.env's
# `env_file:`, which passes its lines straight through with no interpolation.
# These values end up inside the container regardless (docker-compose.yml's
# `environment:` block builds DATABASE_URL and the S3 credentials from them),
# so this file is exactly as sensitive as api.env: gitignored, mode 600.
#
#   cp .env.example .env && chmod 600 .env && nano .env
# ---------------------------------------------------------------------------

# Rotate: `openssl rand -hex 24`. Read by the `postgres` service only, as the
# cluster's own bootstrap/admin user — the official postgres image always
# grants POSTGRES_USER full superuser (rolsuper/createdb/createrole/
# replication/bypassrls all true; there is no image option to avoid this).
# The application itself never connects as this role — see
# POSTGRES_APP_USER below — so this password only needs to be known to
# whoever administers the database directly (e.g. `docker exec ... psql -U
# ${POSTGRES_USER}` for one-off admin tasks), never to the running app.
POSTGRES_DB=speednum
POSTGRES_USER=speednum
POSTGRES_PASSWORD=

# The actual application role — this is what `api`/`migrate`'s DATABASE_URL
# uses (see docker-compose.yml). NOT a superuser: created once via
#   ALTER DATABASE speednum OWNER TO speednum_app;
#   GRANT ALL PRIVILEGES ON ALL TABLES/SEQUENCES IN SCHEMA public TO speednum_app;
#   GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA public TO speednum_app;
# (owning the database gives it implicit CREATE on the `public` schema for
# future migrations via Postgres's pg_database_owner membership, without
# needing to be a superuser itself). See DEPLOYMENT.md's "Least-privilege
# database role" section for the exact one-time setup script — it only needs
# to run once per fresh Postgres data directory, not on every deploy.
POSTGRES_APP_USER=speednum_app
POSTGRES_APP_PASSWORD=

# Rotate: `openssl rand -hex 24` for the password; a shorter alphanumeric
# name is fine for the user. Read by `minio` (server credentials), `minio-init`
# (to create the bucket) and `api` (as S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY —
# see docker-compose.yml's `api` service).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Read by `minio-init` to name the bucket it creates. Must match
# S3_BUCKET in api.env.
S3_BUCKET=documents

# Read by the `frontend` service's `build.args` (see docker-compose.yml) — NOT by a running
# container, since NEXT_PUBLIC_* is inlined into the client bundle at build time. Changing
# either of these requires `docker compose up -d --build frontend`, not just a restart.
# Backend API root the frontend calls. No trailing slash, no /api/v1 suffix (the app adds it).
NEXT_PUBLIC_API_URL=https://test.spidnums.com
# This deployment's own public URL — must match api.env's PUBLIC_APP_URL/CORS_ORIGINS.
NEXT_PUBLIC_SITE_URL=https://www.spidnums.com
