# ---------------------------------------------------------------------------
# Copy to deploy/.env on the VPS (note: `.env`, not `api.env` — this is a
# different file). docker compose auto-loads a file with this exact name from
# the project directory to interpolate ${VAR} placeholders inside
# docker-compose.yml itself — a different mechanism from api.env's
# `env_file:`, which passes its lines straight through with no interpolation.
# These values end up inside the container regardless (docker-compose.yml's
# `environment:` block builds DATABASE_URL and the S3 credentials from them),
# so this file is exactly as sensitive as api.env: gitignored, mode 600.
#
#   cp .env.example .env && chmod 600 .env && nano .env
# ---------------------------------------------------------------------------

# Rotate: `openssl rand -hex 24`. Read by the `postgres` service directly
# and by `api`/`migrate`'s DATABASE_URL — one value, not two kept in sync by
# hand. Changing it after the volume already has data requires updating
# Postgres's own password too (`ALTER USER ... PASSWORD ...`), not just this
# file — this only sets the password on first init of an empty data directory.
POSTGRES_DB=speednum
POSTGRES_USER=speednum
POSTGRES_PASSWORD=

# Rotate: `openssl rand -hex 24` for the password; a shorter alphanumeric
# name is fine for the user. Read by `minio` (server credentials), `minio-init`
# (to create the bucket) and `api` (as S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY —
# see docker-compose.yml's `api` service).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Read by `minio-init` to name the bucket it creates. Must match
# S3_BUCKET in api.env.
S3_BUCKET=documents
