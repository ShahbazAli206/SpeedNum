{
  "name": "speednum-desktop",
  "version": "0.1.0",
  "description": "SpeedNum admin desktop — encrypted disaster-recovery backup sync, restore drills, and a thin admin overview. Talks only to the same authenticated FastAPI backend every other SpeedNum client uses; never touches Postgres or MinIO directly.",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --publish=never",
    "release": "electron-builder --publish=always"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.speednum.desktop",
    "productName": "SpeedNum Desktop",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!node_modules/electron-builder/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "SpeedNum Desktop deep link",
        "schemes": ["speednum"]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://test.spidnums.com/desktop-releases/",
        "channel": "latest"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
