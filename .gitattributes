# Large binary media exceeds GitHub's 100 MB per-file limit, so it is stored
# via Git LFS. Clones need `git lfs install` to fetch real content.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text

# Shell scripts must keep LF endings — they run on the Linux VPS, where a CRLF
# would make the shebang/`\r` fail ("bad interpreter"). Force LF regardless of
# the checkout platform's core.autocrlf.
*.sh text eol=lf
