# ---------------------------------------------------------------------------
# Frontend environment variables.
#
# Local dev:  copy this file to `.env.local` and fill in the values.
# Vercel:     set each of these under Project -> Settings -> Environment
#             Variables (Production + Preview), then redeploy.
#
# Every var here is NEXT_PUBLIC_* — it is bundled into the browser build.
# That is fine: the Supabase *anon* key is meant to be public (row-level
# security is what protects the data), and the other values are just URLs.
# Never put the Supabase service-role key or any secret in this file.
#
# If ALL of these are absent the app still builds and runs in "demo mode"
# (sample data, auth disabled). Set them to switch to the real backend.
# ---------------------------------------------------------------------------

# Backend API base URL — your Hugging Face Space root.
# Do NOT include a trailing slash and do NOT append /api/v1 (the app adds it).
# Example: https://shahbazali206-speednum-api.hf.space
NEXT_PUBLIC_API_URL=https://<hf-user>-<space-name>.hf.space

# Supabase project — Project Settings -> API.
# URL is the "Project URL"; the key is the "anon" / "publishable" public key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This deployment's own public URL — used for canonical links / SEO metadata.
# For this project that is your Vercel production domain.
NEXT_PUBLIC_SITE_URL=https://speed-num.vercel.app
