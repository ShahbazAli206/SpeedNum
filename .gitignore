# ---- Python / FastAPI backend ----
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / Next.js frontend ----
node_modules/
.next/
out/
build/
.vercel
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-error.log*

# ---- Secrets ----
# Never commit real environment files; .env.example is the tracked template.
.env
.env.*
!.env.example
# Local-only secret store for deployment credentials (DB password, keys, tokens).
# This file holds live secrets and must NEVER be pushed. DEPLOYMENT.md (committed)
# documents where each secret lives and how to retrieve it instead.
*.secrets.local.md
DEPLOYMENT.secrets.local.md
# Real e2e/QA test credentials (incl. a superadmin login). The committed
# e2e/test-accounts.example.json is the template; the .local.json holds live
# passwords and must NEVER be pushed.
e2e/test-accounts.local.json

# ---- Large media ----
# *.mp4 and *.zip are stored via Git LFS (see .gitattributes).
# *.avi is excluded: at 792 MB it would push total LFS usage past the
# 1 GB free quota. Remove this line once a GitHub LFS data pack is added.
*.avi

# ---- OS / editor ----
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# ---- Deployment ----
# Live secrets for the VPS container (DB password, service-role key, SMTP
# password). deploy/api.env.example is the tracked template.
deploy/api.env
deploy/api.env.bak*
# Live LiveKit/coturn config — the TURN shared secret and (for coturn) the
# VPS's own public IP. deploy/livekit.yaml.example and
# deploy/turnserver.conf.example are the tracked templates.
deploy/livekit.yaml
deploy/turnserver.conf

# ---- Local dev-only artifacts ----
# Self-signed TLS cert/key for local HTTPS dev — never commit key material,
# even a throwaway dev one.
backend/certs/
# Local Postgres data/log/screenshot directory for the portable dev stack —
# runtime state, not source.
.localdb/
# Playwright MCP browser-automation artifacts (console logs + page snapshots).
.playwright-mcp/
